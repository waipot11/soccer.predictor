# GEMINI_API_KEY: Required for Gemini AI + Google Search Grounding API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / RENDER_EXTERNAL_URL: Public base URL when hosted on Render.com or Cloud Run.
APP_URL="MY_APP_URL"
RENDER_EXTERNAL_URL=""

# DATA_DIR: Directory for persistent JSON state on Render.com (e.g. /var/data with Render Disk, or /tmp/kickai-data).
DATA_DIR=""

# Telegram Bot Daily 06:30 AM Thai Time Golden Slip Notification
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_WEBHOOK_URL=""
